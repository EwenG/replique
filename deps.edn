{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {org.clojure/data.json {:mvn/version "2.5.1"}}}
  ;; The clojure whose compiler writes down what it resolved, which is what
  ;; replique.analysis reads. Not a dependency of replique: it is a fork of
  ;; clojure, a process runs one or the other, and everything that reads it is
  ;; written to work either way. Named here so that the tests of it can be run
  ;; against the one that answers - `clojure -M:test:analysis'.
  ;;
  ;; A local root, since there is nowhere to resolve it from: it is built out
  ;; of the checkout next to this one.
  :analysis {:override-deps
             {org.clojure/clojure
              {:local/root "../replique-clj/target/clojure-1.12.5-r1.jar"}}}

  ;; The ClojureScript compiler this process answers .cljs questions out of.
  ;; Not a dependency either, and for a second reason on top of the analysis's:
  ;; it needs the forked clojure to run at all, because a ClojureScript
  ;; namespace is a clojure.lang.Namespace in a NamespaceWorld and stock
  ;; clojure has no such class. So this alias carries the override with it -
  ;; `clojure -M:test:cljs' - and there is no combination that puts the
  ;; compiler on the classpath of a stock clojure.
  :cljs {:override-deps
         {org.clojure/clojure
          {:local/root "../replique-clj/target/clojure-1.12.5-r1.jar"}}
         :extra-deps
         {replique/replique-cljs {:local/root "../replique-cljs"}}}}}
